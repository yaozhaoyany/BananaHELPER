{
  "name": "banana-helper",
  "version": "0.1.0",
  "private": true,
  "description": "Remote-control Codex CLI from Slack, QQ and WeChat through HAPI and AstrBot",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/hapi.mjs hub --no-relay",
    "banana:start": "node scripts/banana.mjs start",
    "banana:status": "node scripts/banana.mjs status",
    "banana:stop": "node scripts/banana.mjs stop",
    "hapi:hub:relay": "node scripts/hapi.mjs hub --relay",
    "hapi:runner:start": "node scripts/hapi.mjs runner start",
    "hapi:runner:status": "node scripts/hapi.mjs runner status",
    "hapi:runner:stop": "node scripts/hapi.mjs runner stop",
    "hapi:codex": "node scripts/hapi.mjs codex",
    "hapi:doctor": "node scripts/hapi.mjs doctor",
    "hapi:token": "node scripts/hapi-token.mjs",
    "astrbot:up": "docker compose up -d astrbot",
    "astrbot:down": "docker compose stop astrbot",
    "astrbot:logs": "docker compose logs -f astrbot",
    "slack:configure": "node scripts/slack-configure.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:stop": "docker compose stop postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "tsx scripts/db-check.ts",
    "db:backup": "node scripts/db-backup.mjs",
    "test:db": "tsx --test test/database.integration.ts",
    "typecheck": "tsc",
    "test": "node --import tsx --test test/*.test.mjs"
  },
  "dependencies": {
    "@twsxtd/hapi": "0.33.1",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
