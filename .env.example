TZ=Asia/Shanghai

# Generate a password locally before running db:up: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=banana
POSTGRES_USER=banana_owner
POSTGRES_PORT=5432
# Optional: use an existing PostgreSQL database instead of the local container.
# DATABASE_URL=postgresql://user:password@host:5432/banana

# Planned integrations only: not read by the current runtime. Leave commented.
# PERSONAL_WEBSITE_REPOSITORY=<PERSONAL_WEBSITE_REPOSITORY_URL>
# PERSONAL_WEBSITE_API_URL=<PERSONAL_WEBSITE_API_URL>
# STOCK_DASHBOARD_REPOSITORY=<STOCK_DASHBOARD_REPOSITORY_URL>
# STOCK_DASHBOARD_API_URL=<STOCK_DASHBOARD_API_URL>

ASTRBOT_IMAGE=soulter/astrbot:latest
ASTRBOT_WEB_PORT=6185
ASTRBOT_ONEBOT_PORT=6199

# Slack Socket Mode. Save real tokens only in this ignored local .env file.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ADMIN_USER_ID=

# HAPI must listen beyond loopback so the AstrBot container can reach it.
HAPI_LISTEN_HOST=0.0.0.0
HAPI_LISTEN_PORT=3006

# Optional: force the public HAPI relay to use TCP when UDP is unavailable.
# HAPI_RELAY_FORCE_TCP=true
