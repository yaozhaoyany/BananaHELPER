{
  "display_information": {
    "name": "BananaHELPER",
    "description": "Personal Codex assistant through AstrBot and HAPI",
    "background_color": "#222222"
  },
  "features": {
    "app_home": { "messages_tab_enabled": true, "messages_tab_read_only_enabled": false },
    "bot_user": { "display_name": "BananaHELPER", "always_online": false }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "channels:history", "channels:read", "groups:history", "groups:read",
        "im:history", "im:read", "im:write", "chat:write",
        "users:read", "files:read", "files:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["message.channels", "message.groups", "message.im"] },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
